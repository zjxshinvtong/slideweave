{
  "envId": "slideweave-d5g8tsj23944c6b5d",
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "api",
      "timeout": 60,
      "memorySize": 512,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false,
      "description": "Slideweave API: /api/health, /api/generate",
      "envVariables": {
        "DEEPSEEK_API_KEY": "sk-REPLACE_ME",
