# ---- DeepSeek / OpenAI-compatible provider ----
# Copy this file to .env.local and fill in the key. Never expose it to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Thinking mode is disabled for fast structured streaming. Set enabled for harder material.
DEEPSEEK_THINKING=disabled

# Alternatively, read the signed-in DeepSeek Harness account grant from this
# computer (no token copied into the project). Requires the DSH desktop app.
# DEEPSEEK_AUTH_MODE=dsh-account

# ---- Local server ----
PORT=4173
HOST=127.0.0.1

# ---- Development / automated UI tests only ----
# MOCK_AI=1
# MOCK_DELAY_MS=14
